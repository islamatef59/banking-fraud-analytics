table fact_transactions
	lineageTag: 8e108986-c5e6-4ed7-a726-3c07ede1f443
	sourceLineageTag: [gold].[fact_transactions]

	measure 'Total Volume' = SUM(fact_transactions[amount])
		lineageTag: 3d47689f-21e2-435d-b2d2-e93cd843e2ca

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Fraud Volume' = ```
			
			CALCULATE(
			    SUM(fact_transactions[amount]), 
			    fact_transactions[isfraud] = TRUE()
			)
			```
		formatString: 0
		lineageTag: 550f1853-e613-45bd-908b-bcb5a429d9a2

		changedProperty = Name

	measure 'Fraud Count' = ```
			
			CALCULATE(
			    COUNTROWS(fact_transactions), 
			    fact_transactions[isfraud] = TRUE()
			)
			```
		formatString: 0
		lineageTag: d25407d8-0644-45c9-b8ed-0ddc915bc2bb

		changedProperty = Name

	measure 'Fraud Rate %' = DIVIDE([Total Fraud Volume], [Total Volume], 0)
		lineageTag: 52b87199-9044-4c1f-852c-94d120a86685

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Risk Txn Count' = ```
			
			CALCULATE(
			    COUNTROWS(fact_transactions), 
			    fact_transactions[type_risk_level] IN {"HIGH", "CRITICAL"}
			)
			```
		formatString: 0
		lineageTag: 977bd3a4-f065-4f15-adcf-b53729f6f8d4

		changedProperty = Name

